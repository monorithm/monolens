# Per-developer agent tooling, not project configuration.
.claude/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Node tooling for commitlint/lefthook, and the docs site's dependencies.
node_modules/
bun.lock

# Astro build output for the docs site. `website/.gitignore` covers these too;
# repeated here so a `git add -A` from the repo root can never pick them up.
/website/dist/
/website/.astro/
/website/.yarn/

# Integration-test fixtures — reproduce with `swift tool/make_fixture.swift`.
# Written rather than committed so the repo carries no binaries.
#
# The contents, not the directory: git cannot re-include a file whose parent
# directory is excluded, so `/example/assets/` would make the negation below
# dead. The directory itself has to survive, because `example/pubspec.yaml`
# declares `assets/` and `flutter analyze` fails on a declared asset directory
# that is not there — which is every clean checkout, since the fixture
# generator is macOS-only and never runs in the analyze job.
/example/assets/*
!/example/assets/.gitkeep
